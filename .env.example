# Copy to .env; never commit the real connection URL/password.
NODE_ENV=development
HOST=0.0.0.0
PORT=3003

# Supabase Dashboard > Connect > Session pooler (IPv4, port 5432).
# Use an operations-only project or a dedicated PostgreSQL login granted access
# only to schema operations. Do not use a shared postgres/admin runtime login.
# URL-encode special characters in the password. This is a Postgres URL,
# NOT the https://<project>.supabase.co URL or an anon/service_role API key.
DATABASE_URL=postgresql://operations_user.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_SCHEMA=operations
DB_SSL=true
# Download the Supabase CA; Docker mounts this file read-only.
DB_SSL_CA_PATH=./certs/supabase-ca.crt
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000

# Only the public key supplied by Auth. Never put auth-private.pem here.
JWT_PUBLIC_KEY_PATH=./keys/auth-public.pem
JWT_ISSUER=restaurant-auth
JWT_AUDIENCE=restaurant-api

# Local broker only for this service. Use the team's URL once provided.
RABBITMQ_URL=amqp://operations_dev:local_operations_only@localhost:5672
RABBITMQ_EXCHANGE=restaurant.events
RABBITMQ_QUEUE=operations.requests.q
RABBITMQ_USER=operations_dev
RABBITMQ_PASSWORD=local_operations_only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# The gateway image is run separately; it listens on 8080.
# From a gateway container to this service running on Windows:
# OPERATIONS_SERVICE_URL=http://host.docker.internal:3003
